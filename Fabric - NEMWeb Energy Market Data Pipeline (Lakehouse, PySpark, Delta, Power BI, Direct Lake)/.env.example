# Copy this file to `.env` for local development. Keep secrets out of this file
# and out of source control.

# Fabric workspace display name used for documentation and notebook messages.
FABRIC_WORKSPACE_NAME=

# Fabric Lakehouse display name used for documentation and notebook messages.
FABRIC_LAKEHOUSE_NAME=

# Base AEMO NEMWeb current reports URL.
NEMWEB_BASE_URL=https://nemweb.com.au/Reports/Current/

# Dispatch interval source used first for near real-time price and demand.
NEMWEB_DISPATCHIS_URL=https://nemweb.com.au/Reports/Current/DispatchIS_Reports/

# Public price source used for price validation and future enrichment.
NEMWEB_PUBLIC_PRICES_URL=https://nemweb.com.au/Reports/Current/Public_Prices/

# Number of recent hours to inspect when listing current-report ZIP files.
INGESTION_LOOKBACK_HOURS=6

# Safety cap for each scheduled ingestion run.
MAX_ZIPS_PER_RUN=500

# Logging verbosity for local scripts and reusable package code.
LOG_LEVEL=INFO

# Fabric notebook library root containing uploaded package folder `nem_fabric`.
FABRIC_NOTEBOOK_LIB_PATH=/lakehouse/default/Files/libs
