APP_NAME=APSIM Copilot
LOG_LEVEL=WARNING
STREAMLIT_SERVER_PORT=8501

# Optional deployment values used by the ACR build/push batch script.
AZ_SUBSCRIPTION=
AZURE_RESOURCE_GROUP=rg-apsimcopilot-dev
AZURE_LOCATION=australiaeast
ACR_NAME=
IMAGE_NAME=apsim-copilot
IMAGE_TAG=USEDATE
BUILD_PLATFORM=linux/amd64
DOCKERFILE_PATH=Dockerfile
ACR_USERNAME=
ACR_PASSWORD=
ACR_PULL_IDENTITY_RESOURCE_ID=
ACR_PULL_IDENTITY_NAME=
ACR_PULL_IDENTITY_RESOURCE_GROUP=
CONTAINER_APP_NAME=
CONTAINER_APP_RESOURCE_GROUP=
CONTAINER_APP_ENVIRONMENT=
LOG_ANALYTICS_WORKSPACE_NAME=log-apsimcopilot-dev
CONTAINER_APP_INGRESS=external
CONTAINER_APP_TARGET_PORT=8501
CONTAINER_APP_CPU=0.5
CONTAINER_APP_MEMORY=1.0Gi

# Optional Azure Key Vault settings for local and deployed secret resolution.
OPENAI_API_KEY_SECRET_NAME=
AZURE_KEY_VAULT_URL=
AZURE_SEARCH_API_KEY_SECRET_NAME=
AZURE_STORAGE_CONNECTION_STRING_SECRET_NAME=
APPLICATIONINSIGHTS_CONNECTION_STRING_SECRET_NAME=

# Optional direct secret values. Leave these blank when using Key Vault.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=apsim-docs
AZURE_SEARCH_VECTOR_DIMENSIONS=1536
AZURE_SEARCH_SEMANTIC_CONFIG=default

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=apsim-copilot
SAVE_UPLOADS_TO_BLOB=false

APPLICATIONINSIGHTS_CONNECTION_STRING=

MAX_SEARCH_RESULTS=5
MAX_CONTEXT_CHARACTERS=12000
CSV_PREVIEW_ROWS=25


# Comment Glossary
# - APP_NAME: display name shown in the Streamlit UI and logs.
# - LOG_LEVEL: application log verbosity; WARNING keeps local runs quieter than INFO.
# - STREAMLIT_SERVER_PORT: port used by Streamlit locally and inside the container.
# - AZ_SUBSCRIPTION: Azure subscription name or ID used by the Docker build/push batch script.
# - AZURE_RESOURCE_GROUP: shared default Azure resource group used across deployment scripts and services.
# - AZURE_LOCATION: Azure region used when creating the Log Analytics workspace and Container Apps environment.
# - ACR_NAME: Azure Container Registry name used by the Docker build/push batch script.
# - IMAGE_NAME: container image repository name inside ACR.
# - IMAGE_TAG: container image tag used for build and deploy; set USEDATE to generate a timestamped tag and reuse it from .last_image_tag.
# - BUILD_PLATFORM: container platform pushed to ACR; Azure Container Apps should use linux/amd64.
# - DOCKERFILE_PATH: optional Dockerfile path used by the build/push batch script.
# - ACR_USERNAME: optional ACR username for Container App registry auth when AcrPull is not configured.
# - ACR_PASSWORD: optional ACR password for Container App registry auth when AcrPull is not configured.
# - ACR_PULL_IDENTITY_RESOURCE_ID: optional full Azure resource ID of the user-assigned managed identity used for ACR image pulls.
# - ACR_PULL_IDENTITY_NAME: optional user-assigned managed identity name used when resolving ACR_PULL_IDENTITY_RESOURCE_ID automatically.
# - ACR_PULL_IDENTITY_RESOURCE_GROUP: optional resource group containing the pull identity; defaults to AZURE_RESOURCE_GROUP when blank.
# - CONTAINER_APP_NAME: Azure Container App name used by the deploy batch script.
# - CONTAINER_APP_RESOURCE_GROUP: optional Container App resource group override; defaults to AZURE_RESOURCE_GROUP when blank.
# - CONTAINER_APP_ENVIRONMENT: Azure Container Apps environment name.
# - LOG_ANALYTICS_WORKSPACE_NAME: Log Analytics workspace name used for Container Apps environment logs.
# - CONTAINER_APP_INGRESS: ingress mode, usually external.
# - CONTAINER_APP_TARGET_PORT: container port exposed by Streamlit.
# - CONTAINER_APP_CPU: CPU allocation for the Container App container.
# - CONTAINER_APP_MEMORY: memory allocation for the Container App container.
# - OPENAI_API_KEY_SECRET_NAME: Key Vault secret name for the OpenAI API key.
# - AZURE_KEY_VAULT_URL: optional Key Vault URL used to resolve secrets locally or in Azure.
# - AZURE_SEARCH_API_KEY_SECRET_NAME: Key Vault secret name for the Azure AI Search admin key.
# - AZURE_STORAGE_CONNECTION_STRING_SECRET_NAME: Key Vault secret name for the storage connection string.
# - APPLICATIONINSIGHTS_CONNECTION_STRING_SECRET_NAME: Key Vault secret name for the App Insights connection string.
# - OPENAI_API_KEY: optional direct secret fallback for chat completions and embeddings.
# - OPENAI_CHAT_MODEL: OpenAI model name used for APSIM answers and file explanations.
# - OPENAI_EMBEDDING_MODEL: OpenAI embeddings model used for document indexing and retrieval.
# - AZURE_SEARCH_ENDPOINT: Azure AI Search service URL, usually https://<service>.search.windows.net.
# - AZURE_SEARCH_API_KEY: optional direct Azure AI Search admin key fallback.
# - AZURE_SEARCH_INDEX_NAME: search index name used for APSIM document chunks.
# - AZURE_SEARCH_VECTOR_DIMENSIONS: embedding vector size that must match the chosen embeddings model.
# - AZURE_SEARCH_SEMANTIC_CONFIG: semantic configuration name on the Azure AI Search index.
# - AZURE_STORAGE_CONNECTION_STRING: optional direct storage account connection string fallback.
# - AZURE_STORAGE_CONTAINER_NAME: blob container name used for docs and optional uploaded files.
# - SAVE_UPLOADS_TO_BLOB: when true, user-uploaded APSIMX and CSV files are stored in Blob Storage.
# - APPLICATIONINSIGHTS_CONNECTION_STRING: optional direct telemetry connection string fallback.
# - MAX_SEARCH_RESULTS: number of search chunks retrieved for each APSIM question.
# - MAX_CONTEXT_CHARACTERS: prompt budget used when packing retrieved context into the LLM request.
# - CSV_PREVIEW_ROWS: number of CSV rows shown in the UI preview.
