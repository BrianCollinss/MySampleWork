{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Retail Customer Event",
  "type": "object",
  "required": [
    "event_id",
    "event_time",
    "event_type",
    "customer_id",
    "session_id",
    "product_id",
    "campaign_id",
    "channel",
    "device_type"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "event_time": { "type": "string", "format": "date-time" },
    "event_type": {
      "type": "string",
      "enum": [
        "product_view",
        "add_to_cart",
        "remove_from_cart",
        "checkout_started",
        "order_submitted",
        "email_clicked"
      ]
    },
    "customer_id": { "type": "string" },
    "session_id": { "type": "string" },
    "product_id": { "type": "string" },
    "campaign_id": { "type": ["string", "null"] },
    "channel": { "type": "string" },
    "device_type": { "type": "string" },
    "order_id": { "type": ["string", "null"] },
    "quantity": { "type": ["integer", "null"] },
    "event_value": { "type": ["number", "null"] }
  }
}
